<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Allow direct access to existing files and directories (like assets/ and api/)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Don't rewrite calls to the PHP API
  RewriteRule ^api/ - [L]

  # Route all other frontend requests to the static index.html
  RewriteRule ^ index.html [L]
</IfModule>
